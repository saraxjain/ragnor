# Copy to .env.local and fill in what you have. Every integration is optional:
# without a key, that feature runs in demo mode on the sample data.

# --- Gemini (LandingCheck video, voice/typed check-ins, FixPlan, coach briefing, HitWatch function calling)
GEMINI_API_KEY=
# Optional: override the model (must support video + function calling)
GEMINI_MODEL=gemini-3.8-flash
# Optional backups if the main model is busy (comma-separated model names you have access to)
GEMINI_FALLBACK_MODELS=
# HitWatch agent engine: adk (Google Agent Development Kit, default) or genai (plain function calling)
HITWATCH_ENGINE=adk

# --- ElevenLabs conversational agent (HitWatch voice)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# For real outbound phone calls (Twilio number imported into ElevenLabs):
ELEVENLABS_PHONE_NUMBER_ID=
# The phone that rings during the demo (E.164, e.g. +14085551234)
DEMO_CALL_TO_NUMBER=
# Optional shared secret the agent's webhook tools send as the x-ragnor-secret header
RAGNOR_TOOL_SECRET=

# --- Google Health API (Fitbit / Pixel Watch). Restricted scopes: add yourselves as test users.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
# Public URL of the app (used for the OAuth redirect: ${APP_URL}/api/health/callback)
APP_URL=http://localhost:3000

# --- Firebase / Firestore mirror (service account)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Demo arc: start before Maya's day-2 call (default) or with the alert already queued
# DEMO_START=after_call

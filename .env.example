# Copy to .env.local and fill in. Never commit real keys. Everything is optional: with nothing set the app runs in demo mode
# (in-memory example data, scripted AI examples, mock wearables, scripted HitWatch). Keys are only ever read on the server.

# Gemini: the "Behind the scenes" debate panel (explains flags; never decides the level). Blank = labelled scripted example.
GEMINI_API_KEY=
# Optional model id override (default gemini-4-hydrogen, the id used in Google's current examples).
GEMINI_MODEL=

# ElevenLabs: HitWatch voice agent. Setup steps in docs/HITWATCH_SETUP.md.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Only for outbound phone calls: the id of the phone number imported into ElevenLabs (needs your Twilio account).
ELEVENLABS_PHONE_NUMBER_ID=

# Google Health API (Fitbit / Pixel Watch). Blank = mock wearable data.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
# OAuth redirect (default http://localhost:3000/api/wearables/google/callback)
GOOGLE_HEALTH_REDIRECT_URI=

# Firebase / Firestore. Blank = in-memory demo store. Credentials: set GOOGLE_APPLICATION_CREDENTIALS to a service-account key file path.
FIREBASE_PROJECT_ID=

# Shared secrets for endpoints that teammates / devices / the voice agent call (header "x-ragnor-secret"). An unset secret disables that endpoint.
# Any long random string, for example: openssl rand -hex 24
INGEST_SECRET=
IMPACT_WEBHOOK_SECRET=
HITWATCH_TOOL_SECRET=
